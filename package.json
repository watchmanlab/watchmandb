{
  "name": "watchmandb",
  "version": "0.1.1",
  "description": "A hyper-fast, reactive embedded database for Bun & Node.js built on LMDB. Features a compile-time static query planner in TypeScript and demand-driven streaming joins. (700K writes/sec, 5M reads/sec)",
  "author": "Soffinal <smari.sofiane@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchmanlab/watchmandb.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bunup": "^0.16.32",
    "dts-bundle-generator": "^9.5.1"
  },
  "peerDependencies": {
    "typescript": "^7",
    "typebox": "^1.4.3",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@watchmanlab/stream": "^0.3.3",
    "lmdb": "^3.5.9"
  },
  "keywords": [
    "database",
    "embedded",
    "lmdb",
    "reactive",
    "stream",
    "performance",
    "orm",
    "typescript",
    "bun",
    "nodejs"
  ],
  "license": "MIT"
}
